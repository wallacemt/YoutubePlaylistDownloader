<UserControl x:Class="YoutubePlaylistDownloader.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             Margin="12"
             Width="{Binding ActualWidth, ElementName=Skeleton}"
             FlowDirection="{DynamicResource FlowDirection}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:00.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Text="{DynamicResource Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="5,0,5,12" />

        <Controls:MetroAnimatedTabControl Grid.Row="1" x:Name="MetroAnimatedTabControl">
            <Controls:MetroTabItem Header="{DynamicResource Search}">
                <Grid x:Name="SearchPlaylistGrid" MaxWidth="1280" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource UiCardStyle}" Padding="8">
                    <Grid x:Name="HeadlineStackPanel" HorizontalAlignment="Stretch" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Controls:Tile Cursor="Hand" Grid.Column="0" Width="58" Height="42" HorizontalAlignment="Left" Margin="0" Click="Tile_Click" ToolTip="{DynamicResource Options}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <iconPacks:PackIconModern Panel.ZIndex="5" HorizontalAlignment="Center" Grid.Row="0" Kind="Cog" Width="20" Height="20" Margin="0" />
                                <TextBlock Panel.ZIndex="0" Grid.Row="1" Text="{DynamicResource Options}" FontSize="9" VerticalAlignment="Bottom"  />
                            </Grid>
                        </Controls:Tile>
                        <TextBox Grid.Column="1" HorizontalAlignment="Stretch" x:Name="PlaylistLinkTextBox" Margin="8,4" FontSize="18" TextChanged="TextBox_TextChanged" Style="{StaticResource SeachBarPlaceHolder}" Tag="{DynamicResource InsertYoutubePlaylistLinkHere}"  />
                    </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Visibility="Collapsed" x:Name="PlaylistInfoGrid" Style="{StaticResource UiFadeInStyle}" HorizontalAlignment="Stretch" MaxHeight="410" Padding="16" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--Col 0-->
                                <Image x:Name="PlaylistInfoImage" Margin="0,0,10,0" Grid.Column="0" Grid.Row="0" Grid.RowSpan="5" MaxWidth="320" MaxHeight="180" />

                                <!--Col 1-->
                                <TextBlock Text="{DynamicResource PlaylistTitle}" Grid.Row="0" Grid.Column="1" FontSize="14" />
                                <TextBlock Text="{DynamicResource Author}"        Grid.Row="1" Grid.Column="1" FontSize="14"/>
                                <TextBlock Text="{DynamicResource Views}"         Grid.Row="2" Grid.Column="1" FontSize="14"/>
                                <TextBlock Text="{DynamicResource TotalVideos}"   Grid.Row="3" Grid.Column="1" FontSize="14" x:Name="PlaylistTotalVideosTextBlockText" />

                                <!--Col 2-->

                                <TextBlock x:Name="PlaylistTitleTextBlock"        Grid.Row="0" Grid.Column="2" FontSize="14"/>
                                <TextBlock x:Name="PlaylistAuthorTextBlock"       Grid.Row="1" Grid.Column="2" FontSize="14"/>
                                <TextBlock x:Name="PlaylistViewsTextBlock"        Grid.Row="2" Grid.Column="2" FontSize="14"/>
                                <TextBlock x:Name="PlaylistTotalVideosTextBlock"  Grid.Row="3" Grid.Column="2" FontSize="14"/>

                            </Grid>
                            </Border>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8">
                                <Controls:Tile Style="{DynamicResource UiActionTileStyle}" x:Name="DownloadVideoButton" Title="{DynamicResource Video}" IsEnabled="False" MinWidth="130" Width="Auto" HorizontalTitleAlignment="Center" Click="DownloadVideoButton_Click" ToolTip="{DynamicResource Options}">
                                    <iconPacks:PackIconModern Width="22" Height="22" Kind="Video" />
                                </Controls:Tile>
                                <Controls:Tile Style="{DynamicResource UiActionTileStyle}" x:Name="DownloadAudioButton" Title="{DynamicResource Audio}" IsEnabled="False" MinWidth="130" Width="Auto" HorizontalTitleAlignment="Center" Click="DownloadAudioButton_Click" ToolTip="{DynamicResource Options}">
                                    <iconPacks:PackIconModern Width="22" Height="22" Kind="Music" />
                                </Controls:Tile>
                                <Controls:Tile Style="{DynamicResource UiActionTileStyle}" x:Name="DownloadInBackgroundButton" Title="{DynamicResource DownloadInBackground}" MinWidth="130" Width="Auto" HorizontalTitleAlignment="Center" IsEnabled="False" Click="DownloadInBackgroundButton_Click">
                                    <iconPacks:PackIconModern Width="24" Height="24" Kind="Reset" />
                                </Controls:Tile>
                            </WrapPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Controls:MetroTabItem>
            <Controls:MetroTabItem Header="{DynamicResource Queue}" x:Name="QueueMetroTabItem">
                <Grid>
                    <ScrollViewer x:Name="QueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="1280">
                        <StackPanel x:Name="QueueStackPanel" Margin="8">
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="{DynamicResource BulkDownload}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" x:Name="BulkScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="1280" Margin="8">
                        <Border Style="{StaticResource UiCardStyle}" Padding="8">
                        <TextBox x:Name="BulkLinksTextBox" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="TextBox_TextChanged_1" FontSize="16" PreviewDrop="BulkLinksTextBox_PreviewDrop" MinHeight="180" />
                        </Border>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Center">
                        <Controls:Tile Style="{DynamicResource UiActionTileStyle}" x:Name="BulkDownloadButton" Title="{DynamicResource Download}" MinWidth="130" Width="Auto" HorizontalTitleAlignment="Center" IsEnabled="False" Click="BulkDownloadButton_Click">
                            <iconPacks:PackIconModern Width="24" Height="24" Kind="ArrowDown" />
                        </Controls:Tile>
                    </WrapPanel>
                </Grid>
            </Controls:MetroTabItem>

        </Controls:MetroAnimatedTabControl>
    </Grid>
</UserControl>
